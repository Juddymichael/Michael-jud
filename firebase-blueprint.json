{
  "entities": {
    "user": {
      "title": "User",
      "description": "Trader user profile and account details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "trade": {
      "title": "Trade",
      "description": "Trading execution record with SMC metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string", "enum": ["BUY", "SELL"] },
        "entryDate": { "type": "string" },
        "exitDate": { "type": "string" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "lotSize": { "type": "number" },
        "pnl": { "type": "number" },
        "netPnl": { "type": "number" },
        "commission": { "type": "number" },
        "swap": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "setup": { "type": "string" },
        "session": { "type": "string" },
        "timeframe": { "type": "string" },
        "entryTrigger": { "type": "string" },
        "plannedRR": { "type": "number" },
        "realizedRR": { "type": "number" },
        "notes": { "type": "string" },
        "screenshotBefore": { "type": "string" },
        "tradingViewUrl": { "type": "string" }
      },
      "required": ["id", "symbol", "direction", "entryDate", "entryPrice", "lotSize", "status"]
    },
    "setup": {
      "title": "Setup",
      "description": "SMC trading setup definition and statistical tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "rules": { "type": "string" },
        "winRate": { "type": "number" },
        "totalTrades": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "userSettings": {
      "title": "UserSettings",
      "description": "User preferences, account balance and risk management thresholds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "initialBalance": { "type": "number" },
        "currency": { "type": "string" },
        "riskPerTradePercent": { "type": "number" },
        "timeZone": { "type": "string" }
      },
      "required": ["id"]
    },
    "coachConversation": {
      "title": "CoachConversation",
      "description": "Interactive AI Coach conversations and message history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string", "enum": ["user", "model"] },
              "content": { "type": "string" },
              "createdAt": { "type": "string" },
              "toolCalls": { "type": "array" }
            }
          }
        }
      },
      "required": ["id", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile document"
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": "trade",
      "description": "User private trades collection"
    },
    "/users/{userId}/setups/{setupId}": {
      "schema": "setup",
      "description": "User private SMC trading setups"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "userSettings",
      "description": "User private settings and account configurations"
    },
    "/users/{userId}/coachConversations/{conversationId}": {
      "schema": "coachConversation",
      "description": "User private coach conversational threads"
    }
  }
}
